# ============================================================
# Caddyfile · Reverse Proxy con HTTPS Automático (Let's Encrypt)
# Dominio Canónico de Producción: hub.wiloxdev.com
# ============================================================

hub.wiloxdev.com {
	# Seguridad estricta: TLS 1.3 forzado y hardening de encabezados HTTP
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "interest-cohort=()"
	}

	# Proxy inverso hacia el License Hub (red interna Docker segura)
	reverse_proxy license-hub:8444 {
		header_up X-Forwarded-Proto https
		header_up Host {host}
	}
}
