# ============================================================
# AUTO-SWITCHER PRO · LICENSE HUB · VARIABLES DE ENTORNO
# ============================================================
# Instrucciones:
#   1. cp .env.example .env
#   2. Genera los secretos con:
#        openssl rand -hex 24   -> ADMIN_TOKEN
#        openssl rand -hex 32   -> PRIVATE_SEED_HEX
#   3. chmod 600 .env
#   4. NUNCA comitear .env a Git (ya está en .gitignore)
# ============================================================

# Puerto interno de escucha del License Hub (dentro de la red Docker)
PORT=8444

# Ruta de la base de datos JSON de licencias
DB_PATH=/data/licenses.json

# Token de administración del panel (REQUERIDO - sin default)
# Generar: openssl rand -hex 24
ADMIN_TOKEN=

# Semilla privada Ed25519 para firmar licencias comerciales (REQUERIDO - sin default)
# Generar: openssl rand -hex 32
PRIVATE_SEED_HEX=

# Dominio público con HTTPS servido por Caddy (opcional, para referencia)
# PUBLIC_DOMAIN=hub.tudominio.com
