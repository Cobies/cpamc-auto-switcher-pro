{
  "manifest_version": 3,
  "name": "CPAMC Session Syncer Pro",
  "version": "1.0.0",
  "description": "Sincronizador 1-Click de sesiones Web (Gemini Argon, cookies HttpOnly) hacia CLIProxyAPI / Auto Switcher Pro",
  "permissions": [
    "cookies",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://gemini.google.com/*",
    "*://*.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sincronizar sesión con CPAMC"
  }
}
